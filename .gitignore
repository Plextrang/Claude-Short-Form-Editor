# --- client material: creative directions, sound packs, generated styles, examples. NEVER commit it.
# Only the empty template ships. Back up your clients/ folder yourself (it exists only on your machine).
clients/*
!clients/_template/
work/active_style.json
remotion/src/data/style_theme.ts

# --- your videos and everything generated from them (never commit footage)
input/*
!input/.gitkeep
!input/music/
input/music/*
!input/music/.gitkeep
deliverables/*
!deliverables/.gitkeep
archive/*
!archive/.gitkeep
remotion/out/
remotion/public/*
!remotion/public/.gitkeep
remotion/src/scenes/*
!remotion/src/scenes/.gitkeep
remotion/src/preview/*
!remotion/src/preview/.gitkeep
remotion/src/data/edit.ts
remotion/src/data/words.json
remotion/src/data/scenes.ts
remotion/src/data/palette.ts
work/audio/
work/frames/
work/music/
work/music_audition/
work/*.log
work/plan/*
!work/plan/CRAFT_DEFAULTS.md
!work/plan/ENGINE.md
work/transcript/*

# --- installed tools (recreated by the first-run setup)
remotion/node_modules/
work/pylibs/
work/brand_cache/
work/hf_cache/
__pycache__/
*.pyc

# --- OS / editor noise
.DS_Store
Thumbs.db
*.stackdump
